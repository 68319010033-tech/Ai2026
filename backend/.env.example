PORT=3000
# comma-separated list of allowed origins, or * for all
CORS_ORIGIN=http://localhost:5173
# optional: serve the built Vue app from this same Express service (e.g. ../frontend/dist)
FRONTEND_DIST=
MAX_UPLOAD_MB=10

# ---- Firebase / Firestore (leave all empty = in-memory only) ----
# Option 1 (easiest on Cloud hosts): base64 of the service-account JSON.  Linux/mac: base64 -w0 serviceAccount.json
FIREBASE_SERVICE_ACCOUNT_BASE64=
# Option 2: the JSON itself, or a path to the .json file
FIREBASE_SERVICE_ACCOUNT= backend/serviceAccountKey.json
# Option 3: Google Cloud default credentials (Cloud Run / GCE) -> set to true
FIREBASE_USE_ADC=
FIREBASE_PROJECT_ID=
# only if you use a named (non-default) Firestore database
FIRESTORE_DATABASE_ID=achirawit-a6198
# collection prefix -> sc_datasets, sc_jobs
FIRESTORE_PREFIX=
# local emulator: 127.0.0.1:8080
FIRESTORE_EMULATOR_HOST=
